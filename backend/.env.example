# TransitOps Backend Environment Variables
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-address>/transitops?retryWrites=true&w=majority
JWT_SECRET=your_super_secure_random_jwt_secret_min_32_chars
JWT_EXPIRES_IN=7d
FRONTEND_URL=https://your-frontend-deployment.vercel.app

# AI Fleet Copilot (Google Gemini API Key)
# If omitted or invalid, AI Copilot operates with deterministic grounded database intelligence
GEMINI_API_KEY=your_google_gemini_api_key_here
